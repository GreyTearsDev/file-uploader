<form 
  action="/user/sign-up" 
  method="POST"
  class="
    max-w-md
    mx-auto
    p-4
    bg-white
    shadow-md
    rounded-md
    mt-10
  ">
    <%- include("./partials/required_fields_warning")%>
    <fieldset class="border border-gray-300 rounded p-4 mb-6">
        <legend class="text-lg font-semibold text-gray-700">Sign up</legend>

        <%- include("partials/form_label", { 
          labelInfo: { 
            for: "username", 
            text: "* Username" 
          } 
        }) %>

        <%- include("partials/form_input", { 
          inputInfo:{
            type: "text",
            id: "username",
            name: "username",
            maxLength: 40,
            placeholder: "username",
            value: user.username || '', 
            required: "required"
          }
        })%>

        <%- include("partials/form_label", { 
          labelInfo: { 
            for: "password", 
            text: "* Password" 
          } 
        }) %>

        <%- include("partials/form_input", { 
          inputInfo:{
            type: "password",
            id: "password",
            maxLength: 80,
            name: "password",
            value: user.password || '',
            required: "required"
          }
        })%>

        <%- include("partials/form_label", { 
          labelInfo: { 
            for: "password_confirmation", 
            text: "* Confirm password" 
          } 
        }) %>

        <%- include("partials/form_input", { 
          inputInfo:{
            type: "password",
            id: "password_confirmation",
            name: "password_confirmation",
            required: "required"
          }
        })%>

      </fieldset>

    <%- include("partials/form_button", { btnInfo: { text: "Sign up", color: "pink", type: "submit" } })%>

    <h2 class="text-m mt-4">
      Already have an account? <a href="/user/log-in" class="text-pink-600"> Log in now!</a>
    </h2>

    <%- include("errors/form_error", {errors: errors})%>
</form>

